# Normalize to LF in the repo; check out with native endings except where noted.
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must keep LF (Gradle wrapper runs in Linux CI)
gradlew text eol=lf
*.sh text eol=lf

# Binaries
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.pdf binary
*.epub binary
*.ttf binary
*.otf binary
