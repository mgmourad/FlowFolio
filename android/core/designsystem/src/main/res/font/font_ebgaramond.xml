<?xml version="1.0" encoding="utf-8"?>
<!-- A reading font for EPUBs (M3, ADR-0027): regular and bold, upright and italic. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/reading_ebgaramond" android:fontStyle="normal" android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/reading_ebgaramond" android:fontStyle="normal" android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
    <font android:font="@font/reading_ebgaramond_italic" android:fontStyle="italic" android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/reading_ebgaramond_italic" android:fontStyle="italic" android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
</font-family>
