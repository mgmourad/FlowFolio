<?xml version="1.0" encoding="utf-8"?>
<!-- A reading font for EPUBs (M3, ADR-0027): regular and bold, upright and italic. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/reading_charter" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/reading_charter_italic" android:fontStyle="italic" android:fontWeight="400" />
    <font android:font="@font/reading_charter_bold" android:fontStyle="normal" android:fontWeight="700" />
    <font android:font="@font/reading_charter_bold_italic" android:fontStyle="italic" android:fontWeight="700" />
</font-family>
