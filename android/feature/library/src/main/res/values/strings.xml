    <!-- Storage choice: wording approved by the product owner (Phase 1 plan). -->
    <string name="storage_title">Where should FlowFolio keep your books?</string>
    <string name="storage_title_each">Import this book</string>
    <string name="storage_copy">Keep a copy in FlowFolio</string>
    <string name="storage_copy_disclaimer">FlowFolio stores its own copy of this book. It keeps working offline and even if the original is moved or deleted. Removing the book from FlowFolio deletes the copy.</string>
    <string name="storage_copy_disclaimer_sized">FlowFolio stores its own copy of this book (%1$s). It keeps working offline and even if the original is moved or deleted. Removing the book from FlowFolio deletes the copy.</string>
    <string name="storage_link">Read from its current location</string>
    <string name="storage_link_disclaimer">FlowFolio reads the file where it is and doesn\'t use extra space. If the file is moved, renamed or deleted, or the app or cloud service holding it removes access, the book won\'t open until you locate it again. Files stored in the cloud may need an internet connection.</string>
    <string name="storage_change_later">You can change this any time in Settings.</string>
    <string name="storage_shared_note">Books shared from other apps are always copied, because Android doesn\'t let FlowFolio keep access to them.</string>

    <string name="link_not_possible_title">Can\'t read this file in place</string>
    <string name="link_not_possible_body">The app holding this file doesn\'t let FlowFolio keep access to it. You can keep a copy in FlowFolio instead.</string>

    <string name="delete_title">Remove “%1$s”?</string>
    <string name="delete_body_copy">FlowFolio\'s copy of this book will be deleted. Your original file is not affected.</string>
    <string name="delete_body_link">The book will be removed from your library. The file itself stays where it is.</string>

