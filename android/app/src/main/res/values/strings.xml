<resources>
    <string name="app_name">FlowFolio</string>
    <string name="tab_library">Library</string>
    <string name="tab_shelves">Shelves</string>
    <string name="tab_notebook">Notebook</string>
    <string name="tab_settings">Settings</string>
    <string name="splash_tagline">Every textbook, reflowed. Every page, kept.</string>
    <!-- The automatic update check's notice (Phase 4 M5). -->
    <string name="update_banner_title">Update available</string>
    <string name="update_banner_text">%1$s · tap to open Settings</string>
    <string name="update_banner_dismiss">Dismiss</string>
    <string name="updated_banner_title">FlowFolio was updated</string>
    <string name="updated_banner_text">You are now on %1$s</string>
    <!-- The "what's new" window shown once after an update. -->
    <string name="whats_new_title">What\'s new</string>
    <string name="whats_new_version">Version %1$s</string>
    <string name="whats_new_ok">Ok</string>
    <!-- Dynamic Flow notices in the app (ADR-0045). -->
    <string name="flow_notice_started">Preparing Dynamic Flow</string>
    <string name="flow_notice_started_text">%1$s keeps converting while you read.</string>
    <string name="flow_notice_done">Dynamic Flow is ready</string>
    <string name="flow_notice_done_text">%1$s now flows to fit your screen. Tap to read.</string>
    <string name="flow_notice_failed">Dynamic Flow couldn\'t prepare this book</string>
    <string name="flow_notice_failed_text">%1$s stays a PDF.</string>
    <string name="flow_notice_interrupted_text">%1$s stopped part-way. Choose Dynamic Flow to try again.</string>
    <string name="flow_notice_carrying">Bringing your notes across</string>
    <string name="flow_notice_carrying_text">Highlights, notes and bookmarks in %1$s</string>
    <string name="flow_notice_carried">Your notes came across</string>
    <string name="flow_notice_carried_text">%1$d of %2$d found their place.</string>
    <!-- TM1: before a scanned book is read by OCR. -->
    <string name="scan_notice_title">This book is a scan</string>
    <string name="scan_notice_body">Its pages are pictures, so Dynamic Flow reads them with text recognition. The text may not be exactly right, and it takes a while: %1$s for this book.\n\nYou can keep reading the original, or read another book. You will get a notification when it is ready.</string>
    <string name="scan_notice_convert">Convert</string>
    <string name="scan_notice_not_now">Not now</string>
    <string name="scan_notice_dont_ask">Don\'t show this again</string>
    <plurals name="scan_notice_minutes">
        <item quantity="one">about a minute</item>
        <item quantity="other">about %1$d minutes</item>
    </plurals>
    <plurals name="scan_notice_hours">
        <item quantity="one">about an hour</item>
        <item quantity="other">about %1$d hours</item>
    </plurals>
