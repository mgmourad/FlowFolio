{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowfolio.app/schemas/flowfolio-1.0.0.json",
  "title": "FlowFolio sidecar (flowfolio.json), spec 1.0.0",
  "description": "Normative schema for docs/conversion-spec.md section 3. Mirrors android/core/conversion/.../epub/Sidecar.kt; CorpusTest checks every corpus book's sidecar against it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "bookId", "complete", "source", "pages", "blocks", "graph", "health", "recipe"],
  "properties": {
    "specVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "bookId": { "type": "string" },
    "complete": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256", "pageCount"],
      "properties": {
        "fileName": { "type": "string" },
        "sha256": { "type": "string" },
        "pageCount": { "type": "integer", "minimum": 0 },
        "title": { "type": ["string", "null"] },
        "isbn": { "type": ["string", "null"] }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "width", "height", "kind", "xhtml"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "pageLabel": { "type": ["string", "null"] },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "kind": { "enum": ["born-digital", "scanned", "empty"] },
          "xhtml": { "type": "string" }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockId", "type", "page", "bbox", "xhtml", "confidence", "method"],
        "properties": {
          "blockId": { "type": "string", "pattern": "^p[0-9]{4,}-b[0-9]{3,}$" },
          "type": {
            "enum": ["heading", "paragraph", "list", "figure", "caption", "table", "equation", "sidebar", "code", "fallback"]
          },
          "page": { "type": "integer", "minimum": 1 },
          "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "xhtml": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "method": { "type": "string" },
          "continuesFrom": { "type": ["string", "null"] }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "label", "blockId"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "type": "string" },
              "label": { "type": "string" },
              "blockId": { "type": "string" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "kind"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "kind": { "type": "string" }
            }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageThreshold", "summary", "pages"],
      "properties": {
        "coverageThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pages", "pagesBelowThreshold", "fallbackPages", "scannedPages", "chapters", "chaptersFrom", "fallbackBlocks"],
          "properties": {
            "pages": { "type": "integer", "minimum": 0 },
            "pagesBelowThreshold": { "type": "integer", "minimum": 0 },
            "fallbackPages": { "type": "integer", "minimum": 0 },
            "scannedPages": { "type": "integer", "minimum": 0 },
            "chapters": { "type": "integer", "minimum": 0 },
            "chaptersFrom": { "enum": ["outline", "headings", "pages"] },
            "fallbackBlocks": { "type": "integer", "minimum": 0 }
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page", "textCoverage", "geometricCoverage", "status", "drawingsAsImages"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "textCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
              "geometricCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
              "status": { "enum": ["ok", "degraded", "scanned"] },
              "drawingsAsImages": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "components", "settings"],
      "properties": {
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "components": { "type": "object", "additionalProperties": { "type": "string" } },
        "settings": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
